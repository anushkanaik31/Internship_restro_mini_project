{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "baseUrl": "./",
    "types": ["node"],  
    "esModuleInterop": true
  },
  "files": [
    "src/main.ts",
    "src/main.server.ts", 
    "server.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts", 
    "src/**/*.ts",    
    "src/polyfills.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules"
  ]
}
